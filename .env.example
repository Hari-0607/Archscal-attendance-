# Web app (apps/web/.env.local for local development)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# NestJS API (root .env for Docker Compose)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true&connection_limit=10
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
CORS_ORIGINS=http://localhost:3000
IP_HASH_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
TRUST_PROXY_HOPS=0
METRICS_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
METRICS_TOKEN_FILE=./.secrets/metrics-token
REDIS_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
REDIS_URL=redis://:REPLACE_WITH_A_LONG_RANDOM_SECRET@redis:6379
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
GRAFANA_ROOT_URL=http://localhost:3001
ELASTIC_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
KIBANA_SYSTEM_PASSWORD=REPLACE_WITH_ELASTIC_KIBANA_SYSTEM_PASSWORD
KIBANA_ROOT_URL=http://localhost:5601

# Production-only. Store as protected provider secrets; never commit values.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
